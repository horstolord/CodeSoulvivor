@using Sandbox;
@using Sandbox.UI;
@using System;
@using Sandbox.Code.Actors;
@using Sandbox.Code.Data;
@using Sandbox.Code.Systems;
@inherits PanelComponent

<root class="ui-root">
    <div class="hud-container">
        @if ( PlayerObject != null && PlayerObject.StatSheet != null )
        {
            var stats = PlayerObject.StatSheet;
            var maxHp = stats.MaxHealth?.Value ?? 100f;
            var maxStam = stats.MaxStamina?.Value ?? 100f;
            var maxNrg = stats.MaxEnergy?.Value ?? 100f;

            <div class="hud-bar-wrapper">
                <div class="hud-bar-header">
                    <div class="hud-bar-label">Health</div>
                    <div class="hud-bar-text">@((int)stats.CurrentHealth) / @((int)maxHp) (@((int)HealthWidth)%)</div>
                </div>
                <div class="hud-bar-bg">
                    <div class="hud-bar-fill health" style="width: @(HealthWidth)%;"></div>
                </div>
            </div>

            <div class="hud-bar-wrapper">
                <div class="hud-bar-header">
                    <div class="hud-bar-label">Stamina</div>
                    <div class="hud-bar-text">@((int)stats.CurrentStamina) / @((int)maxStam) (@((int)StaminaWidth)%)</div>
                </div>
                <div class="hud-bar-bg">
                    <div class="hud-bar-fill stamina" style="width: @(StaminaWidth)%;"></div>
                </div>
            </div>

            <div class="hud-bar-wrapper">
                <div class="hud-bar-header">
                    <div class="hud-bar-label">Mana</div>
                    <div class="hud-bar-text">@((int)stats.CurrentEnergy) / @((int)maxNrg) (@((int)EnergyWidth)%)</div>
                </div>
                <div class="hud-bar-bg">
                    <div class="hud-bar-fill mana" style="width: @(EnergyWidth)%;"></div>
                </div>
            </div>

            <div class="hud-flasks-section">
                <div class="hud-section-label">Equipped Flasks</div>
                <div class="hud-flasks-container">
                    @foreach ( var (slot, keyLabel) in new[] { (EquipmentSlot.Flask1, "[1]"), (EquipmentSlot.Flask2, "[2]") } )
                    {
                        var equippedFlask = InventoryState.GetEquippedItem( slot );
                        var hasFlask = equippedFlask != null;
                        var hasCharges = hasFlask && equippedFlask.RemainingCharges > 0;

                        <div class="hud-flask-card @(hasFlask ? equippedFlask.RarityClass : "empty") @(hasCharges ? "charged" : "depleted")"
                             onclick="@(() => InventoryState.UseFlask(slot))"
                             pointer-events="all">
                            <span class="hud-flask-key">@keyLabel</span>
                            @if ( hasFlask )
                            {
                                <div class="hud-flask-icon">@equippedFlask.IconGlyph</div>
                                <div class="hud-flask-count">@equippedFlask.RemainingCharges/@equippedFlask.MaxCharges</div>
                            }
                            else
                            {
                                <div class="hud-flask-icon empty">FL</div>
                                <div class="hud-flask-count">-</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="hud-bar-label">Searching for Player Stats...</div>
        }
    </div>

    @if ( ActivePanel != UiPanel.None )
    {
        <div class="menu-backdrop"></div>
    }

    @if ( ActivePanel == UiPanel.Inventory )
    {
        <div class="inventory-screen">
            <div class="equipment-root">
                <div class="equipment-header">
                    <span class="title">Character Equipment</span>
                    <span class="subtitle">Equipment & Flask System</span>
                </div>

                <div class="paperdoll-container">
                    <div class="slot-column left">
                        @foreach ( var equipmentSlot in LeftEquipmentSlots )
                        {
                            var equippedItem = InventoryState.GetEquippedItem( equipmentSlot.Slot );
                            var hasItem = equippedItem != null;

                            <div class="equip-slot @(hasItem ? equippedItem.RarityClass : "empty")"
                                 onmousedown="@(() => InventoryState.EquipSelectedItemTo(equipmentSlot.Slot))">
                                @if ( hasItem )
                                {
                                    <div class="item-icon">@equippedItem.IconGlyph</div>
                                    <button class="unequip-btn" onclick="@(() => InventoryState.Unequip(equipmentSlot.Slot))">X</button>
                                }
                                else
                                {
                                    <div class="ghost-icon">@equipmentSlot.Ghost</div>
                                    <span class="slot-label">@equipmentSlot.Label</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="paperdoll-silhouette">
                        <div class="silhouette-head"></div>
                        <div class="silhouette-body"></div>
                        <div class="overlay-slots">
                            @foreach ( var equipmentSlot in CenterEquipmentSlots )
                            {
                                var equippedItem = InventoryState.GetEquippedItem( equipmentSlot.Slot );
                                var hasItem = equippedItem != null;

                                <div class="equip-slot @(hasItem ? equippedItem.RarityClass : "empty")"
                                     onmousedown="@(() => InventoryState.EquipSelectedItemTo(equipmentSlot.Slot))">
                                    @if ( hasItem )
                                    {
                                        <div class="item-icon">@equippedItem.IconGlyph</div>
                                        @if ( equippedItem.MaxCharges > 0 )
                                        {
                                            <span class="item-quantity">@equippedItem.RemainingCharges/@equippedItem.MaxCharges</span>
                                        }
                                        <button class="unequip-btn" onclick="@(() => InventoryState.Unequip(equipmentSlot.Slot))">X</button>
                                    }
                                    else
                                    {
                                        <div class="ghost-icon">@equipmentSlot.Ghost</div>
                                        <span class="slot-label">@equipmentSlot.Label</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="slot-column right">
                        @foreach ( var equipmentSlot in RightEquipmentSlots )
                        {
                            var equippedItem = InventoryState.GetEquippedItem( equipmentSlot.Slot );
                            var hasItem = equippedItem != null;

                            <div class="equip-slot @(hasItem ? equippedItem.RarityClass : "empty")"
                                 onmousedown="@(() => InventoryState.EquipSelectedItemTo(equipmentSlot.Slot))">
                                @if ( hasItem )
                                {
                                    <div class="item-icon">@equippedItem.IconGlyph</div>
                                    <button class="unequip-btn" onclick="@(() => InventoryState.Unequip(equipmentSlot.Slot))">X</button>
                                }
                                else
                                {
                                    <div class="ghost-icon">@equipmentSlot.Ghost</div>
                                    <span class="slot-label">@equipmentSlot.Label</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="stats-summary">
                    <div class="summary-title">Equipment Bonuses</div>
                    <div class="stats-grid">
                        <div class="stat-box atk">ATK: +@InventoryState.TotalAttack</div>
                        <div class="stat-box def">DEF: +@InventoryState.TotalDefense</div>
                        <div class="stat-box spd">SPD: +@InventoryState.TotalSpeed</div>
                    </div>
                </div>
            </div>

            <div class="inventory-root">
                <div class="inventory-header">
                    <div class="title-wrapper">
                        <span class="panel-title">Player Inventory</span>
                        <span class="capacity-text">@InventoryState.UsedSlots / @InventoryState.TotalSlots Slots</span>
                    </div>
                    <div class="grid-badge">9x4 Grid</div>
                </div>

                <div class="inventory-grid">
                    @foreach ( var slot in InventoryState.Slots )
                    {
                        <div class="inventory-slot @(slot.IsLocked ? "locked" : "") @(slot.Item != null ? slot.Item.RarityClass : "") @(InventoryState.SelectedSlotId == slot.Id ? "selected" : "")"
                             onmousedown="@(() => InventoryState.OnSlotMouseDown(slot))"
                             onmouseup="@(() => InventoryState.OnSlotMouseUp(slot))"
                             onmouseover="@(() => InventoryState.SetHoveredItem(slot.Item))"
                             onmouseout="@(() => InventoryState.SetHoveredItem(null))">
                            @if ( slot.IsLocked )
                            {
                                <div class="slot-lock">LOCK</div>
                            }
                            else if ( slot.Item != null )
                            {
                                <div class="item-container">
                                    <div class="item-icon">@slot.Item.IconGlyph</div>

                                    @if ( slot.Item.Quantity > 1 )
                                    {
                                        <span class="item-quantity">x@slot.Item.Quantity</span>
                                    }
                                    else if ( slot.Item.MaxCharges > 0 )
                                    {
                                        <span class="item-quantity">@slot.Item.RemainingCharges/@slot.Item.MaxCharges</span>
                                    }

                                    @if ( CanEquip( slot ) )
                                    {
                                        <button class="slot-action" onclick="@(() => InventoryState.EquipItem(slot))">Equip</button>
                                    }
                                    else if ( slot.Item.Definition.IsConsumable )
                                    {
                                        <button class="slot-action use-btn" onclick="@(() => InventoryState.UseConsumable(slot))">Use</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-dot"></div>
                            }
                        </div>
                    }
                </div>

                @if ( InventoryState.HoveredItem != null )
                {
                    var item = InventoryState.HoveredItem;

                    <div class="item-tooltip">
                        <div class="tooltip-header">
                            <span class="item-name @item.RarityClass">@item.Name</span>
                            <span class="rarity-badge @item.RarityClass">@item.Rarity</span>
                        </div>
                        <p class="item-desc">@item.Description</p>

                        @if ( item.MaxCharges > 0 )
                        {
                            <div class="tooltip-extra charges-tag">Flask Charges: @item.RemainingCharges / @item.MaxCharges (Refills on Kill)</div>
                        }

                        @if ( item.Stats.Attack > 0 || item.Stats.Defense > 0 || item.Stats.Speed > 0 )
                        {
                            <div class="stats-row">
                                @if ( item.Stats.Attack > 0 )
                                {
                                    <span class="stat-atk">+@item.Stats.Attack ATK</span>
                                }
                                @if ( item.Stats.Defense > 0 )
                                {
                                    <span class="stat-def">+@item.Stats.Defense DEF</span>
                                }
                                @if ( item.Stats.Speed > 0 )
                                {
                                    <span class="stat-spd">+@item.Stats.Speed SPD</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if ( ActivePanel == UiPanel.Skills )
    {
        <div class="test-panel skills-panel">
            <div class="test-panel-title">Skills Panel</div>
            <div class="test-panel-body">
                <div>Test panel open.</div>
                <div>Skill list and talents can be wired here later.</div>
            </div>
        </div>
    }
</root>

@code
{
    public static InventoryPanel LocalInventory { get; private set; }

    public enum UiPanel
    {
        None,
        Inventory,
        Skills
    }

    private readonly InventoryPanel InventoryState = new();

    private readonly EquipmentSlotView[] LeftEquipmentSlots =
    {
        new( EquipmentSlot.Head, "Head / Helmet", "HD" ),
        new( EquipmentSlot.Chest, "Chest Armor", "CH" ),
        new( EquipmentSlot.Hands, "Gloves / Hands", "GL" ),
        new( EquipmentSlot.Belt, "Waist / Belt", "BT" ),
        new( EquipmentSlot.Feet, "Boots / Feet", "FT" )
    };

    private readonly EquipmentSlotView[] CenterEquipmentSlots =
    {
        new( EquipmentSlot.Amulet, "Amulet", "AM" ),
        new( EquipmentSlot.Flask1, "Flask 1", "FL1" ),
        new( EquipmentSlot.Flask2, "Flask 2", "FL2" )
    };

    private readonly EquipmentSlotView[] RightEquipmentSlots =
    {
        new( EquipmentSlot.MainHand1, "Main Hand", "MH" ),
        new( EquipmentSlot.OffHand1, "Off Hand", "OH" ),
        new( EquipmentSlot.Ring1, "Ring 1", "R1" ),
        new( EquipmentSlot.Ring2, "Ring 2", "R2" )
    };

    public Player PlayerObject => Player.Local;
    public StatSheet PlayerStatSheet => PlayerObject?.StatSheet;

    [Property] private float HealthWidth { get; set; } = 100f;
    [Property] private float StaminaWidth { get; set; } = 100f;
    [Property] private float EnergyWidth { get; set; } = 100f;
    [Property] public UiPanel ActivePanel { get; set; } = UiPanel.None;

    protected override void OnStart()
    {
        base.OnStart();
        LocalInventory = InventoryState;
    }

    protected override void OnUpdate()
    {
        if ( PlayerObject != null && PlayerObject.StatSheet != null )
        {
            var stats = PlayerObject.StatSheet;
            float maxHp = stats.MaxHealth?.Value ?? 100f;
            float targetHp = maxHp > 0 ? (stats.CurrentHealth / maxHp) * 100f : 0f;
            float maxStam = stats.MaxStamina?.Value ?? 100f;
            float targetStam = maxStam > 0 ? (stats.CurrentStamina / maxStam) * 100f : 0f;
            float maxNrg = stats.MaxEnergy?.Value ?? 100f;
            float targetNrg = maxNrg > 0 ? (stats.CurrentEnergy / maxNrg) * 100f : 0f;
            float lerpSpeed = 8.0f;

            HealthWidth = HealthWidth.LerpTo( targetHp, Time.Delta * lerpSpeed );
            StaminaWidth = StaminaWidth.LerpTo( targetStam, Time.Delta * lerpSpeed );
            EnergyWidth = EnergyWidth.LerpTo( targetNrg, Time.Delta * lerpSpeed );
        }

        if ( Input.Pressed( "Inventory" ) )
        {
            TogglePanel( UiPanel.Inventory );
        }

        if ( Input.Pressed( "Skills" ) )
        {
            TogglePanel( UiPanel.Skills );
        }

        if ( Input.EscapePressed && ActivePanel != UiPanel.None )
        {
            ActivePanel = UiPanel.None;
        }
    }

    void TogglePanel( UiPanel panel )
    {
        ActivePanel = ActivePanel == panel ? UiPanel.None : panel;
    }

    bool CanEquip( InventorySlot slot )
    {
        return slot?.Item?.Definition?.IsEquippable == true;
    }

    protected override int BuildHash()
    {
        if ( PlayerObject?.StatSheet == null )
        {
            return HashCode.Combine(
                false,
                ActivePanel,
                InventoryState.Revision
            );
        }

        var stats = PlayerObject.StatSheet;
        return HashCode.Combine(
            HashCode.Combine( true, ActivePanel, InventoryState.Revision, HealthWidth ),
            StaminaWidth,
            EnergyWidth,
            stats.CurrentHealth,
            stats.CurrentStamina,
            stats.CurrentEnergy
        );
    }

    private readonly record struct EquipmentSlotView( EquipmentSlot Slot, string Label, string Ghost );
}

